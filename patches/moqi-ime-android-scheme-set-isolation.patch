diff --git a/input_methods/rime/android_scheme_set.go b/input_methods/rime/android_scheme_set.go
new file mode 100644
index 0000000..bf33321
--- /dev/null
+++ b/input_methods/rime/android_scheme_set.go
@@ -0,0 +1,104 @@
+//go:build android
+
+package rime
+
+import (
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+)
+
+const androidSchemeSetIsolationMarker = ".moqi_scheme_set_isolated_v1"
+
+// prepareAndroidSchemeSet migrates the package before librime loads or checks
+// timestamps. Older builds could move default.yaml into trash and compile the
+// embedded default into the package's build directory instead.
+func prepareAndroidSchemeSet(userDir string) (forceFullCheck bool, err error) {
+	marker := filepath.Join(userDir, androidSchemeSetIsolationMarker)
+	source := filepath.Join(userDir, "default.yaml")
+	buildDir := filepath.Join(userDir, "build")
+	generated := filepath.Join(buildDir, "default.yaml")
+	if _, err := os.Lstat(marker); err == nil {
+		// Also retry the deploy if an earlier process stopped after migration
+		// but before rebuilding an existing source config.
+		_, sourceErr := os.Stat(source)
+		_, generatedErr := os.Stat(generated)
+		return sourceErr == nil && errors.Is(generatedErr, os.ErrNotExist), nil
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return false, err
+	}
+
+	if _, err := os.Lstat(source); errors.Is(err, os.ErrNotExist) {
+		if err := recoverAndroidSchemeSetDefault(userDir, source); err != nil {
+			return false, err
+		}
+	} else if err != nil {
+		return false, err
+	}
+
+	// Invalidate only the compiled default, not other package or user data.
+	// A manually restored root config can have the same timestamps as before.
+	if info, err := os.Lstat(buildDir); err == nil && info.IsDir() {
+		if info, err := os.Lstat(generated); err == nil && info.Mode().IsRegular() {
+			if err := os.Remove(generated); err != nil && !errors.Is(err, os.ErrNotExist) {
+				return false, err
+			}
+		} else if err != nil && !errors.Is(err, os.ErrNotExist) {
+			return false, err
+		}
+	} else if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return false, err
+	}
+
+	if err := os.WriteFile(marker, nil, 0o600); err != nil {
+		return false, err
+	}
+	return true, nil
+}
+
+func recoverAndroidSchemeSetDefault(userDir, destination string) error {
+	trash := filepath.Join(userDir, "trash")
+	if info, err := os.Lstat(trash); err == nil && !info.IsDir() {
+		return nil
+	} else if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return nil
+		}
+		return err
+	}
+
+	backup := filepath.Join(trash, "default.yaml")
+	if info, err := os.Lstat(backup); err == nil && !info.Mode().IsRegular() {
+		return nil
+	} else if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return nil
+		}
+		return err
+	}
+
+	in, err := os.Open(backup)
+	if err != nil {
+		return err
+	}
+	defer in.Close()
+
+	// Android's external-files filesystem need not support hard links. Use
+	// exclusive creation instead: never replace the user's current config,
+	// and always keep the original backup in trash.
+	out, err := os.OpenFile(destination, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if errors.Is(err, os.ErrExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	_, copyErr := io.Copy(out, in)
+	closeErr := out.Close()
+	if err := errors.Join(copyErr, closeErr); err != nil {
+		_ = os.Remove(destination)
+		return err
+	}
+	return nil
+}
diff --git a/input_methods/rime/android_scheme_set_test.go b/input_methods/rime/android_scheme_set_test.go
new file mode 100644
index 0000000..bf84760
--- /dev/null
+++ b/input_methods/rime/android_scheme_set_test.go
@@ -0,0 +1,101 @@
+//go:build android
+
+package rime
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestPrepareAndroidSchemeSetRestoresDefaultAndInvalidatesCache(t *testing.T) {
+	dir := t.TempDir()
+	const original = "config_version: '0.50'\nschema_list: [{schema: package_schema}]\n"
+	writeAndroidSchemeSetFile(t, dir, "trash/default.yaml", original)
+	writeAndroidSchemeSetFile(t, dir, "build/default.yaml", "config_version: '0.51'\n")
+	writeAndroidSchemeSetFile(t, dir, "build/package_schema.table.bin", "keep generated dictionary")
+	writeAndroidSchemeSetFile(t, dir, "user.yaml", "keep user preferences")
+
+	if force, err := prepareAndroidSchemeSet(dir); err != nil || !force {
+		t.Fatalf("initial prepare: force=%t, err=%v", force, err)
+	}
+	assertAndroidSchemeSetFile(t, dir, "default.yaml", original)
+	assertAndroidSchemeSetFile(t, dir, "trash/default.yaml", original)
+	assertAndroidSchemeSetFile(t, dir, "build/package_schema.table.bin", "keep generated dictionary")
+	assertAndroidSchemeSetFile(t, dir, "user.yaml", "keep user preferences")
+	assertAndroidSchemeSetFileMissing(t, dir, "build/default.yaml")
+
+	if force, err := prepareAndroidSchemeSet(dir); err != nil || !force {
+		t.Fatalf("interrupted deploy should retry: force=%t, err=%v", force, err)
+	}
+	writeAndroidSchemeSetFile(t, dir, "build/default.yaml", "newly built config")
+	if force, err := prepareAndroidSchemeSet(dir); err != nil || force {
+		t.Fatalf("completed deployment should not migrate again: force=%t, err=%v", force, err)
+	}
+	assertAndroidSchemeSetFile(t, dir, "build/default.yaml", "newly built config")
+}
+
+func TestPrepareAndroidSchemeSetPreservesManualRestore(t *testing.T) {
+	dir := t.TempDir()
+	writeAndroidSchemeSetFile(t, dir, "default.yaml", "manually restored config")
+	writeAndroidSchemeSetFile(t, dir, "trash/default.yaml", "old backup")
+	writeAndroidSchemeSetFile(t, dir, "build/default.yaml", "old generated config")
+	old := time.Unix(1500000000, 0)
+	if err := os.Chtimes(filepath.Join(dir, "default.yaml"), old, old); err != nil {
+		t.Fatal(err)
+	}
+
+	if force, err := prepareAndroidSchemeSet(dir); err != nil || !force {
+		t.Fatalf("must force deploy despite old source timestamp: force=%t, err=%v", force, err)
+	}
+	assertAndroidSchemeSetFile(t, dir, "default.yaml", "manually restored config")
+	assertAndroidSchemeSetFile(t, dir, "trash/default.yaml", "old backup")
+	assertAndroidSchemeSetFileMissing(t, dir, "build/default.yaml")
+
+	if err := os.Remove(filepath.Join(dir, "default.yaml")); err != nil {
+		t.Fatal(err)
+	}
+	if force, err := prepareAndroidSchemeSet(dir); err != nil || force {
+		t.Fatalf("do not restore intentionally removed config later: force=%t, err=%v", force, err)
+	}
+	assertAndroidSchemeSetFileMissing(t, dir, "default.yaml")
+}
+
+func TestPrepareAndroidSchemeSetDoesNotUseNonRegularTrash(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(dir, "trash", "default.yaml"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if force, err := prepareAndroidSchemeSet(dir); err != nil || !force {
+		t.Fatalf("initial prepare should ignore directories: force=%t, err=%v", force, err)
+	}
+	assertAndroidSchemeSetFileMissing(t, dir, "default.yaml")
+}
+
+func writeAndroidSchemeSetFile(t *testing.T, root, rel, content string) {
+	t.Helper()
+	path := filepath.Join(root, filepath.FromSlash(rel))
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(content), 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func assertAndroidSchemeSetFile(t *testing.T, root, rel, want string) {
+	t.Helper()
+	got, err := os.ReadFile(filepath.Join(root, filepath.FromSlash(rel)))
+	if err != nil || string(got) != want {
+		t.Fatalf("%s = %q, err=%v; want %q", rel, got, err, want)
+	}
+}
+
+func assertAndroidSchemeSetFileMissing(t *testing.T, root, rel string) {
+	t.Helper()
+	if _, err := os.Lstat(filepath.Join(root, filepath.FromSlash(rel))); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("expected %s to be missing, stat error=%v", rel, err)
+	}
+}
